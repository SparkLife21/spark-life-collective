# Production site URL used for canonical links, Open Graph, sitemap, and robots.
# OPEN DECISION: confirm the public domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JOTFORM EMBED: Root & Rise registration
# Paste the Jotform form URL (iframe src) when Spark Life shares it.
NEXT_PUBLIC_JOTFORM_ROOT_AND_RISE_URL=

# DONATE EMBED: [Givebutter/Donorbox/PayPal Giving Fund — confirm platform]
# Set a donate page URL, or replace the DonateEmbed component with an embed snippet.
NEXT_PUBLIC_DONATE_URL=

# EMAIL SIGNUP: connect to ESP
# Form action URL for the newsletter capture (name optional, email required).
NEXT_PUBLIC_NEWSLETTER_ACTION_URL=

# OPEN DECISION: which inbox /contact should go to
NEXT_PUBLIC_CONTACT_EMAIL=

# OPEN DECISION: confirm social handles before adding — don't guess.
# Format: Label|https://url,Label|https://url
NEXT_PUBLIC_SOCIAL_LINKS=
